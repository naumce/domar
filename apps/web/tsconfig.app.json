{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext", "moduleResolution": "Bundler", "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve", "noEmit": true, "types": ["vite/client"], "baseUrl": ".", "paths": { "@/*": ["src/*"] }, "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "test/**/*.ts", "env.d.ts"]
}
