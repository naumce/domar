# Postgres connection for the API and migrations
DATABASE_URL=postgres://domar:domar@localhost:54329/domar
# Admin connection used by tests to create throwaway databases
DATABASE_ADMIN_URL=postgres://domar:domar@localhost:54329/postgres
# API
API_PORT=3001
API_HOST=127.0.0.1
# Comma-separated origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:5173
# Set to "production" on servers; enables Secure cookies
NODE_ENV=development
# Trust X-Forwarded-* headers: false (default), true, a hop count, or an IP/CIDR list
TRUST_PROXY=false
# Server timezone; invoice numbering years use server local time until tenants carry a timezone
TZ=Europe/Skopje
# Browser channel for PDF rendering (chrome | chromium | msedge)
PDF_BROWSER_CHANNEL=chrome
# Web, development only: API origin without a path prefix. Production builds leave it unset and the
# bundle calls its own origin, because the API serves the web assets.
VITE_API_URL=http://localhost:3001
# Serve apps/web/dist from the API with an SPA fallback (the production image sets this to true)
SERVE_WEB=false
# Override the directory of the built web assets (default: apps/web/dist next to the API)
WEB_DIST=
# Where uploaded documents are written (spec §4). Git- and docker-ignored; a named volume in
# docker-compose.prod.yml. Relative paths resolve against the process working directory.
DATA_DIR=./data
# Production only: the public hostname Caddy issues a certificate for
DOMAIN=
# Production only: the database password docker-compose.prod.yml gives Postgres and puts into
# DATABASE_URL unescaped, so keep it URL-safe (letters, digits, - and _). Compose refuses to start
# while this is empty.
POSTGRES_PASSWORD=
# Production only: Postgres role and database name (defaults used when left empty)
POSTGRES_USER=domar
POSTGRES_DB=domar
# Production only: where scripts/backup.sh writes dumps (default: ./backups)
BACKUP_DIR=./backups
# SMTP connection for outgoing mail. Empty disables email: the app never crashes, it queues every
# reminder as a printable letter instead. `json` selects an in-memory transport (tests only).
# Local development with the compose mailpit service: smtp://localhost:1025
SMTP_URL=
# Envelope sender. Quoted because docs/DEPLOY.md's cron line sources this file with `.`
EMAIL_FROM="domar <no-reply@localhost>"
# Public origin of the web app, e.g. https://domar.mk. When set, the portal invite email carries
# the registration link; leave empty and the email only names the page.
PUBLIC_WEB_URL=
# Shared secret for POST /api/jobs/reminders (header x-job-token). Required when NODE_ENV=production.
# At least 16 characters; generate one with: openssl rand -hex 32
JOB_TOKEN=

# Web Push (spec §9). Empty disables push entirely: notifications are still written and still shown
# in the app, and the delivery job falls back to email. Generate a pair with:
#   pnpm --filter @domar/api exec web-push generate-vapid-keys
# `memory` as the private key selects an in-memory transport (tests only).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push service may use to reach you; mailto: or https:
VAPID_SUBJECT=mailto:no-reply@localhost

# --- Domexa migration (apps/api/scripts/domexa, docs/MIGRATION.md) -----------------
# Only set while migrating; the API never reads these. The export is read-only.
# Base of the Domexa API. Set it to https://domexa.mk/<org> if the API is nested under the org.
DOMEXA_BASE_URL=https://domexa.mk
# The Domexa organization slug, e-mail and password of a user who may read everything
DOMEXA_ORG=
DOMEXA_EMAIL=
DOMEXA_PASSWORD=
# A session cookie captured from a logged-in browser ("name=value"), for when Turnstile blocks the
# API login. When it is set, no login call is made at all.
DOMEXA_COOKIE=
# The domar tenant the transformed data is applied to. A non-localhost URL needs --yes.
DOMAR_URL=http://localhost:3001
DOMAR_SLUG=
DOMAR_EMAIL=
DOMAR_PASSWORD=

# Per-IP ceiling on login, registration and password changes each minute. Leave at 10 in production.
AUTH_RATE_MAX=10
