# Postgres connection for the API and migrations
DATABASE_URL=postgres://domar:domar@localhost:54329/domar
# Admin connection used by tests to create throwaway databases
DATABASE_ADMIN_URL=postgres://domar:domar@localhost:54329/postgres
# API
API_PORT=3001
API_HOST=127.0.0.1
# Comma-separated origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:5173
# Set to "production" on servers; enables Secure cookies
NODE_ENV=development
# Trust X-Forwarded-* headers: false (default), true, a hop count, or an IP/CIDR list
TRUST_PROXY=false
# Server timezone; invoice numbering years use server local time until tenants carry a timezone
TZ=Europe/Skopje
# Browser channel for PDF rendering (chrome | chromium | msedge)
PDF_BROWSER_CHANNEL=chrome
# Web: API origin without a path prefix
VITE_API_URL=http://localhost:3001
