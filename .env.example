# Postgres connection for the API and migrations
DATABASE_URL=postgres://domar:domar@localhost:54329/domar
# Admin connection used by tests to create throwaway databases
DATABASE_ADMIN_URL=postgres://domar:domar@localhost:54329/postgres
# API
API_PORT=3001
API_HOST=127.0.0.1
# Comma-separated origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:5173
# Set to "production" on servers; enables Secure cookies
NODE_ENV=development
# Trust X-Forwarded-* headers: false (default), true, a hop count, or an IP/CIDR list
TRUST_PROXY=false
# Server timezone; invoice numbering years use server local time until tenants carry a timezone
TZ=Europe/Skopje
# Browser channel for PDF rendering (chrome | chromium | msedge)
PDF_BROWSER_CHANNEL=chrome
# Web, development only: API origin without a path prefix. Production builds leave it unset and the
# bundle calls its own origin, because the API serves the web assets.
VITE_API_URL=http://localhost:3001
# Serve apps/web/dist from the API with an SPA fallback (the production image sets this to true)
SERVE_WEB=false
# Override the directory of the built web assets (default: apps/web/dist next to the API)
WEB_DIST=
# Production only: the public hostname Caddy issues a certificate for
DOMAIN=
# Production only: the database password docker-compose.prod.yml gives Postgres and puts into
# DATABASE_URL unescaped, so keep it URL-safe (letters, digits, - and _). Compose refuses to start
# while this is empty.
POSTGRES_PASSWORD=
# Production only: Postgres role and database name (defaults used when left empty)
POSTGRES_USER=domar
POSTGRES_DB=domar
# Production only: where scripts/backup.sh writes dumps (default: ./backups)
BACKUP_DIR=./backups
# SMTP connection for outgoing mail. Empty disables email: the app never crashes, it records
# reminders as failed with 'smtp_not_configured'. `json` selects an in-memory transport (tests only).
# Local development with the compose mailpit service: smtp://localhost:1025
SMTP_URL=
# Envelope sender. Quoted because docs/DEPLOY.md's cron line sources this file with `.`
EMAIL_FROM="domar <no-reply@localhost>"
# Shared secret for POST /api/jobs/reminders (header x-job-token). Required when NODE_ENV=production.
JOB_TOKEN=
